APP_NAME="Agriculture AI Assistant"
ENVIRONMENT="development"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="agriculture_ai"

JWT_SECRET_KEY="your-super-secret-key-change-this"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_MINUTES=10080

GEMINI_API_KEY=""
GEMINI_API_KEYS=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_CHAT_FALLBACK_MODEL="gemini-2.5-flash-lite"
EMBEDDING_MODEL="local-hash"
GEMINI_CHAT_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_CHAT_TIMEOUT_SECONDS=120
GEMINI_CHAT_MAX_RETRIES=2
GEMINI_CHAT_RETRY_BASE_SECONDS=1.0
TEMPERATURE=0.2

CHROMA_PERSIST_DIR="./chroma_data"
CHROMA_COLLECTION_NAME="agriculture_documents"
TOP_K=5
ENABLE_LEXICAL_SEARCH=true
LEXICAL_CACHE=true
RAG_SEMANTIC_THRESHOLD=0.0
RAG_MIN_LEXICAL_SIMILARITY=0.25

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=50
MAX_IMAGE_UPLOAD_MB=10

SPEECH_MAX_UPLOAD_MB=25
FFMPEG_TIMEOUT_SECONDS=30
FFMPEG_PATH="ffmpeg"
EDGE_TTS_MYANMAR_VOICE="my-MM-ThihaNeural"
EDGE_TTS_ENGLISH_VOICE="en-US-GuyNeural"
EDGE_TTS_RATE="+0%"
TTS_MAX_CHARACTERS=3000
GEMINI_STT_MODEL="gemini-2.5-flash"
GEMINI_STT_FALLBACK_MODEL="gemini-2.5-flash-lite"
GEMINI_STT_TIMEOUT_SECONDS=120
GEMINI_STT_MAX_RETRIES=2
GEMINI_STT_RETRY_BASE_SECONDS=1.0

ADMIN_EMAIL="admin@example.com"
LOCAL_EMBEDDING_DIMENSIONS=768
