########################################
# Application Settings
########################################
APP_NAME="Myanmar Proverbs AI Tutor"
ENVIRONMENT="development"

########################################
# CORS / Frontend
########################################
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

########################################
# Database (MongoDB)
########################################
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="mm_proverbs_ai"

########################################
# Authentication (JWT)
########################################
JWT_SECRET_KEY="your-super-secret-key-change-this"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_MINUTES=10080

########################################
# LLM (Ollama local utilities + optional Gemini chat)
########################################
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:0.6b"
OLLAMA_TIMEOUT_SECONDS=120
TEMPERATURE=0.0
OLLAMA_TEMPERATURE=0.0
CHAT_MODEL="qwen3:0.6b"
CHAT_PROVIDER="ollama"
FAST_RESPONSE_MODE=true
FAST_CHAT_MODEL="qwen3:0.6b"
CHAT_NUM_PREDICT=160
CHAT_NUM_CTX=2048
CHAT_TEMPERATURE=0.2
UTILITY_MODEL="qwen3:0.6b"
UTILITY_NUM_PREDICT=96
UTILITY_NUM_CTX=1024

# Ollama embedding model. Re-index when changed.
EMBEDDING_MODEL="bge-m3"

# Metadata generation during DOCX import
METADATA_BATCH_SIZE=5
METADATA_MAX_CONCURRENT=2
METADATA_MAX_RETRIES=3

########################################
# Vector Database (ChromaDB)
########################################
CHROMA_PERSIST_DIR="./chroma_data"
CHROMA_COLLECTION_NAME="proverbs"

########################################
# RAG Settings
########################################
ENABLE_QUERY_REWRITE=false
ENABLE_LEXICAL_SEARCH=true
ENABLE_METADATA_FILTERING=true
LEXICAL_CACHE=true
RAG_TOP_K=2
RAG_MIN_RELEVANCE_SCORE=0.5
RAG_MIN_LEXICAL_SIMILARITY=0.5
RAG_SEMANTIC_THRESHOLD=0.5

########################################
# Speech-to-text (Gemini + FFmpeg)
########################################
SPEECH_MAX_UPLOAD_MB=25
FFMPEG_TIMEOUT_SECONDS=30
# Optional: set this when ffmpeg is not on PATH, for example:
# FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"
FFMPEG_PATH="ffmpeg"

########################################
# Text-to-speech (Edge TTS)
########################################
EDGE_TTS_MYANMAR_VOICE="my-MM-NilarNeural"
EDGE_TTS_ENGLISH_VOICE="en-US-AriaNeural"
EDGE_TTS_RATE="+0%"
TTS_MAX_CHARACTERS=3000

########################################
# Gemini
########################################
GEMINI_API_KEY=""
# Optional: comma-separated key rotation.
# Example: GEMINI_API_KEYS="key1,key2,key3"
GEMINI_API_KEYS=""
GEMINI_CHAT_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_CHAT_MODEL="gemini-flash-latest"
GEMINI_CHAT_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_CHAT_TIMEOUT_SECONDS=120
GEMINI_CHAT_MAX_RETRIES=2
GEMINI_CHAT_RETRY_BASE_SECONDS=1.0
GEMINI_STT_MODEL="gemini-3.5-flash"
GEMINI_STT_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_STT_TIMEOUT_SECONDS=120
GEMINI_STT_MAX_RETRIES=2
GEMINI_STT_RETRY_BASE_SECONDS=1.0

########################################
# Admin Control
########################################
ADMIN_EMAIL="admin@example.com"
